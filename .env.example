# URL publik situs (tanpa slash di akhir). Dipakai untuk SEO, sitemap, dan Open Graph.
NEXT_PUBLIC_SITE_URL=https://namakamu.vercel.app

# Form kontak (opsional tapi wajib agar pesan benar-benar terkirim di production).
# Daftar gratis di https://resend.com lalu buat API key.
RESEND_API_KEY=
# Email tujuan: pesan dari form akan masuk ke sini.
CONTACT_TO_EMAIL=emailkamu@gmail.com
# Pengirim. Sebelum verifikasi domain, pakai default di bawah.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
